# Supabase (browser: anon key + Row Level Security)
# local_demo | supabase. Keep local_demo unless actively testing verified Supabase Auth.
AUTH_MODE=local_demo
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. NEVER prefix with NEXT_PUBLIC_.
# Service role bypasses RLS. Use only in API routes / Edge Functions.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres for migrations/admin scripts only.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Server-only AI providers. NEVER prefix with NEXT_PUBLIC_.
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=gpt-4o-mini

# App environment
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Feature flags
# Keep false on Vercel until remote persistence is intentionally deployed.
# NEXT_PUBLIC_ENABLE_DB_SYNC=false

# Planned remote data switch; currently documented for future Supabase adapters.
# NEXT_PUBLIC_USE_SUPABASE_DATA=false

# Cloudflare R2 media storage (server only unless explicitly marked public).
# Used for future signed uploads. Never prefix access keys or secret keys with NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=academy-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Payments (server only unless explicitly marked public by provider docs)
# tranzila | cardcom | grow_meshulam
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_TERMINAL_ID=
PAYMENT_SANDBOX=true

# Optional Firebase client config for Auth/Firestore/Storage/notifications work.
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Browser Push / Web Push.
# Public key may be exposed; private key and subject are server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Messaging providers. Default blank/no-op; keep sandbox true until approved.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_SANDBOX=true
SMS_PROVIDER=
SMS_API_KEY=
SMS_SANDBOX=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_SANDBOX=true

# Future webhook signatures. Server only.
MEDIA_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_SECRET=
