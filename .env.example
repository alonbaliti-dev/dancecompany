# ─── Supabase (browser — anon key + Row Level Security) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Server only — NEVER prefix with NEXT_PUBLIC_ ───
# Service role bypasses RLS. Use only in API routes / Edge Functions.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Optional: direct Postgres (migrations, admin scripts) ───
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Server-only AI providers — NEVER prefix with NEXT_PUBLIC_ ───
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=gpt-4o-mini

# ─── App environment ───
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ─── Feature flags (optional remote config) ───
# NEXT_PUBLIC_USE_SUPABASE_DATA=false
